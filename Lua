    ScaleToggle.TextSize = 11
    Instance.new("UICorner", ScaleToggle).CornerRadius = UDim.new(0, 6)

    local isCompact = false
    ScaleToggle.MouseButton1Click:Connect(function()
        isCompact = not isCompact
        Main.Size = isCompact and UDim2.new(0, 520, 0, 300) or (isV1 and UDim2.new(0, 720, 0, 420) or UDim2.new(0, 620, 0, 360))
    end)

    local LangToggle = Instance.new("TextButton", SettingsPanel)
    LangToggle.Size = UDim2.new(1, 0, 0, 38)
    LangToggle.Position = UDim2.new(0, 0, 0, 91)
    LangToggle.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
    LangToggle.Font = Enum.Font.GothamBold
    LangToggle.Text = "🌐 ภาษา / Language (TH / EN)"
    LangToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    LangToggle.TextSize = 11
    Instance.new("UICorner", LangToggle).CornerRadius = UDim.new(0, 6)

    local isThai = true
    LangToggle.MouseButton1Click:Connect(function()
        isThai = not isThai
        if isThai then
            Btn1.Text = "👥 รายชื่อผู้เล่น"
            Btn2.Text = "🎭 แปลงร่าง & อมตะ"
            Btn3.Text = "⚙️ ตั้งค่า GUI"
            GotoBtn.Text = "🚀 เทเลפורตไปหา (Goto)"
            KickBtn.Text = "❌ เตะผู้เล่น (Kick)"
            GodBtn.Text = "🛡️ เปิดโหมดอมตะ (God Mode)"
            MorphBtn.Text = "🎭 แปลงร่างก๊อป 100% (True Clone)"
