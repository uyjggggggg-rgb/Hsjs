-- ตารางเก็บ Drawing ESP ของแต่ละผู้เล่น
local espEnabled = false
local espDrawings = {}

local function removeESP(player)
    if espDrawings[player] then
        for _, obj in pairs(espDrawings[player]) do
            obj:Remove()
        end
        espDrawings[player] = nil
    end
end

-- ฟังก์ชันอัปเดตรายชื่อผู้เล่นแบบ Real-time
local function updatePlayerList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local PlayerButton = Instance.new("TextButton")
            PlayerButton.Size = UDim2.new(1, 0, 0, 35)
            PlayerButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            PlayerButton.Text = "  " .. player.Name
            PlayerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            PlayerButton.TextSize = 14
            PlayerButton.TextXAlignment = Enum.TextXAlignment.Left
            PlayerButton.Font = Enum.Font.SourceSans
            PlayerButton.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = PlayerButton

            -- เมื่อกดเลือกชื่อผู้เล่นเพื่อ Teleport ไปข้างหลัง
            PlayerButton.MouseButton1Click:Connect(function()
                for _, btn in ipairs(ScrollingFrame:GetChildren()) do
                    if btn:IsA("TextButton") then
                        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                    end
                end
                PlayerButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
                
                if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHRP = player.Character.HumanoidRootPart
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    if myHRP then
                        local backPosition = targetHRP.CFrame * CFrame.new(0, 0, 5)
                        myHRP.CFrame = backPosition
                    end
                end
            end)
        end
    end
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 40)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
    updatePlayerList()
end)
updatePlayerList()

-- ลูปการทำงานของ ESP แบบ Real-time (แสดง ชื่อ, เลือด, ระยะทาง)
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            -- ตรวจสอบว่าเปิด ESP อยู่ไหม และผู้เล่นมีตัวละครพร้อมไหม
            if espEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                local character = player.Character
                local hrp = character.HumanoidRootPart
                local humanoid = character.Humanoid

                -- สร้าง Drawing Text ถ้ายังไม่มี
                if not espDrawings[player] then
                    local text = Drawing.new("Text")
                    text.Visible = false
                    text.Center = true
                    text.Outline = true
                    text.Font = 2
                    text.Size = 16
                    text.Color = Color3.fromRGB(255, 255, 255)
                    espDrawings[player] = {Text = text}
                end

                local espText = espDrawings[player].Text

                -- คำนวณตำแหน่งบนหน้าจอ (WorldToViewportPoint)
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))

                if onScreen then
                    -- คำนวณระยะห่าง
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local distance = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0

                    -- ดึงค่าเลือด
                    local health = math.floor(humanoid.Health)
                    local maxHealth = math.floor(humanoid.MaxHealth)

                    -- กำหนดข้อความที่จะแสดง
                    espText.Text = string.format("%s\nHP: %d/%d | [%dm]", player.Name, health, maxHealth, distance)
                    espText.Position = Vector2.new(vector.X, vector.Y)
                    espText.Visible = true
                else
                    espText.Visible = false
                end
            else
                -- ซ่อนหรือลบ ESP ทิ้งถ้าปิดใช้งานหรือตัวละครตาย
                if espDrawings[player] and espDrawings[player].Text then
                    espDrawings[player].Text.Visible = false
                end
            end
        end
    end
end)

-- ระบบเปิด/ปิด ESP จากปุ่มในหน้าต่าง
ESPButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        ESPButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50) -- สีเขียวเมื่อเปิด
        ESPButton.Text = "ESP: ON"
    else
        ESPButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50) -- สีแดงเมื่อปิด
        ESPButton.Text = "ESP: OFF"
        -- ซ่อนข้อความทั้งหมดทันทีเมื่อปิด
        for _, data in pairs(espDrawings) do
            if data.Text then
                data.Text.Visible = false
            end
        end
    end
end)

