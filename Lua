local SoundService = game:GetService("SoundService")
local LocalPlayer = Players.LocalPlayer

local function checkAccess()
    if game:GetService("RunService"):IsStudio() then return true end
    if LocalPlayer.Name == "gag2ggez55" then return true end
    return false
end

if not checkAccess() then
    warn("⚠️ [MP Admin]: คุณไม่มีสิทธิ์ใช้งานแอดมินนี้ (เฉพาะบัญชี gag2ggez55 เท่านั้น)")
    return
end

-- ฟังก์ชันเล่นเสียงเปิด UI
local function playIntroSound()
    pcall(function()
        local introSound = Instance.new("Sound")
        introSound.SoundId = "rbxassetid://9063384212" -- สามารถเปลี่ยน Sound ID ตรงนี้ได้ตามต้องการ
        introSound.Volume = 0.6
        introSound.Parent = SoundService
        introSound:Play()
        
        -- ลบ Sound ทิ้งหลังเล่นจบเพื่อไม่ให้รกหน่วยความจำ
        introSound.Ended:Connect(function()
            introSound:Destroy()
        end)
    end)
end

