function openAdminPanel(isV1)
    local ScreenGui = Instance.new("ScreenGui", gethui())
    ScreenGui.Name = "MP_AdminPanel"
    ScreenGui.ResetOnSpawn = false

    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = isV1 and UDim2.new(0, 720, 0, 420) or UDim2.new(0, 620, 0, 360)
