        else
            Btn1.Text = "👥 Real-time Players"
            Btn2.Text = "🎭 Morph & God"
            Btn3.Text = "⚙️ Settings"
            GotoBtn.Text = "🚀 Teleport (Goto)"
            KickBtn.Text = "❌ Kick Player"
            GodBtn.Text = "🛡️ God Mode"
            MorphBtn.Text = "🎭 True Full Clone Morph"
            UnmorphBtn.Text = "🔄 Reset Character"
        end
    end)
